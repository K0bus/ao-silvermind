# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://albion:changeme@localhost:5432/albion_tool"
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://:changeme@localhost:6379"
REDIS_PASSWORD=changeme

# ── MinIO (stockage icônes) ───────────────────────────────────
MINIO_ENDPOINT="http://localhost:9000"
MINIO_USER=albion_minio
MINIO_PASSWORD=changeme_minio
MINIO_BUCKET=albion-icons

# ── Nuxt ──────────────────────────────────────────────────────
# Générer via : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_SECRET=changeme_32_bytes_hex_secret_here

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Email (pour mot de passe oublié) ─────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@albion-silvermind.com

# ── First admin (seed) ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@albion-silvermind-seed.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme_admin

# ── Admin password recovery (logs) ──────────────────────────
# Set this to an admin's email on server startup to print a reset link to logs
RESET_ADMIN_EMAIL=


# ── Discord Bot ───────────────────────────────────────────────
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_BOT_TOKEN=your_bot_token_here
